generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String                @id @default(uuid())
  name               String
  email              String                @unique
  password           String
  role               Role                  @default(SURFER)
  status             UserStatus            @default(ACTIVE)
  countryName        String?
  address            String?
  phoneNumber        String?
  
  // Specific to PHOTOGRAPHER
  paypalEmail        String?

  // Specific to CONTRIBUTOR/PHOTOGRAPHER
  socialAccount      Json?
  
  // Specific to MODERATOR
  permissions        ModeratorPermission[]
  
  // Password reset / OTP
  otp                String?
  otpExpiry          DateTime?
  resetToken         String?
  resetTokenExpiry   DateTime?

  // Auth
  refreshToken       String?
  
  photos             Photo[]
  favorites          Favorite[]
  
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Advertisement {
  id        String   @id @default(uuid())
  imageUrl  String
  linkUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("advertisements")
}

model Location {
  id              String   @id @default(uuid())
  name            String
  parentSpot      String?
  region          String
  state           String
  latitude        Float
  longitude       Float
  photosAvailable Int      @default(0)
  previewImage    String   // Cloudinary URL

  photos          Photo[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([name, region, state])
  @@map("locations")
}

model Photo {
  id             String      @id @default(uuid())
  imageUrl       String
  price          Float
  status         PhotoStatus @default(PENDING)
  
  // EXIF and Time of Day
  timeKey        String      @default("any")
  capturedAt     DateTime?

  // Image metadata
  width          Int?
  height         Int?
  format         String?      // e.g., "jpg", "png"
  fileSize       Int?         // in bytes
  
  photographerId String
  photographer   User        @relation(fields: [photographerId], references: [id])
  
  locationId     String
  location       Location    @relation(fields: [locationId], references: [id])
  
  favoritedBy    Favorite[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([photographerId])
  @@index([locationId])
  @@index([status])
  @@index([timeKey])
  @@map("photos")
}

model Favorite {
  id        String   @id @default(uuid())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, photoId])
  @@index([userId])
  @@map("favorites")
}

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  SURFER
  PHOTOGRAPHER
  MODERATOR
  ADMIN
}

enum ModeratorPermission {
  APPROVE_PHOTO
  ADD_LOCATION
  ALL_ACCESS
}
