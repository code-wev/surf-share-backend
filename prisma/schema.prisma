generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String                @id @default(uuid())
  name               String
  email              String                @unique
  password           String
  role               Role                  @default(SURFER)
  status             UserStatus            @default(ACTIVE)
  subscriptionTier   SubscriptionTier      @default(BRONZE)
  countryName        String?
  address            String?
  phoneNumber        String?
  profileImageUrl    String?
  
  // Specific to PHOTOGRAPHER
  paypalEmail        String?
  // Contributor agreements (shortened names)
  acceptedApproval Boolean? @default(false)
  acceptedContributor Boolean? @default(false)

  // Specific to CONTRIBUTOR/PHOTOGRAPHER
  socialAccount      Json?
  
  // Specific to MODERATOR
  permissions        ModeratorPermission[]
  
  // Password reset / OTP
  otp                String?
  otpExpiry          DateTime?
  resetToken         String?
  resetTokenExpiry   DateTime?

  // Auth
  refreshToken       String?
  promotionEmail     Boolean               @default(false)
  
  photos             Photo[]
  favorites          Favorite[]
  orders             Order[]
  
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model SubscriptionConfig {
  id                 String           @id @default(uuid())
  tier               SubscriptionTier @unique
  photographerSplit  Int
  platformSplit      Int
  maxPrice           Float?
  dailyUploadLimit   Int?
  requiresApproval   Boolean          @default(false)
  
  updatedAt          DateTime         @updatedAt

  @@map("subscription_configs")
}

model Advertisement {
  id        String   @id @default(uuid())
  imageUrl  String
  linkUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("advertisements")
}

model Location {
  id              String   @id @default(uuid())
  name            String
  parentSpot      String?
  region          String
  state           String
  latitude        Float
  longitude       Float
  photosAvailable Int      @default(0)
  previewImage    String   // Cloudinary URL

  photos          Photo[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([name, region, state])
  @@map("locations")
}

model Photo {
  id             String      @id @default(uuid())
  title          String?
  imageUrl       String
  originalUrl    String?
  price          Float
  status         PhotoStatus @default(PENDING)
  
  // EXIF and Time of Day
  timeKey        String      @default("any")
  capturedAt     DateTime?

  // Image metadata
  width          Int?
  height         Int?
  format         String?      // e.g., "jpg", "png"
  fileSize       Int?         // in bytes
  
  photographerId String
  photographer   User        @relation(fields: [photographerId], references: [id])
  
  locationId     String
  location       Location    @relation(fields: [locationId], references: [id])
  
  favoritedBy    Favorite[]
  orderItems     OrderItem[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([photographerId])
  @@index([locationId])
  @@index([status])
  @@index([timeKey])
  @@map("photos")
}

model Favorite {
  id        String   @id @default(uuid())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, photoId])
  @@index([userId])
  @@map("favorites")
}

model Order {
  id              String      @id @default(uuid())
  stripeSessionId String?     @unique
  totalAmount     Float
  status          OrderStatus @default(PENDING)
  
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  
  items           OrderItem[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                   String   @id @default(uuid())
  price                Float
  photographerEarnings Float?
  platformFee          Float?
  
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id])

  @@unique([orderId, photoId])
  @@index([orderId])
  @@map("order_items")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  SURFER
  PHOTOGRAPHER
  MODERATOR
  ADMIN
}

enum SubscriptionTier {
  BRONZE
  SILVER
  GOLD
}

enum ModeratorPermission {
  APPROVE_PHOTO
  ADD_LOCATION
  ALL_ACCESS
}
